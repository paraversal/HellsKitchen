{
	"name": "hells-kitchen",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"predev": "npm run build:data",
		"build": "vite build",
		"prebuild": "npm run build:data",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"precheck": "npm run build:data",
		"test": "vitest run",
		"validate": "node --disable-warning=ExperimentalWarning scripts/validate-data.ts",
		"build:data": "node --disable-warning=ExperimentalWarning scripts/build-data.ts"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@lucide/svelte": "^1.61.0",
		"fflate": "^0.8.3",
		"idb-keyval": "^6.3.0",
		"qrcode": "^1.5.4",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.19.2",
		"@types/qrcode": "^1.5.6",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
